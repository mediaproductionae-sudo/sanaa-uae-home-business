# Build from the existing repository root; the live static entry is unchanged.
FROM node:22-bookworm-slim AS dependencies
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
FROM dependencies AS builder
COPY . .
RUN npm run staging:build
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production PORT=3100 HOSTNAME=0.0.0.0
COPY --from=builder --chown=node:node /app/staging/.next/standalone ./
COPY --from=builder --chown=node:node /app/staging/.next/static ./staging/.next/static
COPY --from=builder --chown=node:node /app/staging/public ./staging/public
USER node
EXPOSE 3100
CMD ["node","staging/server.js"]
