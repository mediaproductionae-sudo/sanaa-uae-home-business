# Copy into staging/.env.local, NEVER the static app. Configure via a secret store.
SUPABASE_ENVIRONMENT=staging
SUPABASE_PROJECT_REF=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
APP_ORIGIN=http://localhost:3100
# Generate independently, at least 32 random bytes; server-only recovery proof.
RECOVERY_COOKIE_SECRET=
# Server-only Storage gateway, never NEXT_PUBLIC_. Not needed to render setup UI.
SUPABASE_SERVICE_ROLE_KEY=
# Local SQL operator only; never used by web routes.
SUPABASE_DB_URL=
# Explicit test override for loopback local Supabase ONLY; keep false in staging.
SUPABASE_ALLOW_LOCAL=false
