# 4A foundation only. No real credentials belong in Git or chat.
# Existing deployment remains static/demo until 4B is approved and deployed.
NEXT_PUBLIC_DATA_MODE=demo
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server/Edge secret store only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# CLI / migration operator only; not required by browser or Next.js build.
SUPABASE_DB_URL=
SUPABASE_PROJECT_REF=
# Backend endpoint configuration will be activated in 4B, not in 4A.
APP_ORIGIN=http://localhost:3000
PAYMENTS_MODE=simulation
